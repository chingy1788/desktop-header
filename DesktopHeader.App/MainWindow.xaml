<Window x:Class="DesktopHeader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Virtual Desktop Header" 
        Height="350" 
        Width="1920"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        Topmost="True" 
        ShowInTaskbar="False" 
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered">

    <Window.Resources>
        <!-- Sleek, Minimal Button Style -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/> <!-- 60% opacity white -->
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Inter, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,5,12,5"/>
            <Setter Property="Margin" Value="3,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                CornerRadius="5" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state for buttons -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#12FFFFFF"/> <!-- Subtle 7% white hover -->
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent" SizeChanged="LayoutRoot_SizeChanged">
        <!-- Unified Premium Full-Width Top Bar Background -->
        <Border x:Name="TopAppBarBackground"
                Height="46"
                Background="#D90C0C0E" 
                BorderBrush="#1AFFFFFF" 
                BorderThickness="0,0,0,1" 
                VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" Color="#000000" />
            </Border.Effect>
        </Border>

        <!-- Low-profile Docked Header Bar (Left-aligned, transparent background, inset margin) -->
        <Border x:Name="MainContainer"
                Margin="16,0,0,0"
                Height="46"
                Background="Transparent" 
                BorderThickness="0" 
                CornerRadius="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                SizeChanged="MainContainer_SizeChanged">
            
            <Grid Margin="4,2,4,2">
                <!-- List of Desktops -->
                <ItemsControl x:Name="DesktopsList" ItemsSource="{Binding Desktops}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" 
                                    Click="DesktopButton_Click"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
                                        <Style.Triggers>
                                            <!-- Flat active highlight state -->
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="ButtonBorder" 
                                                                    CornerRadius="5" 
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Background="#26FFFFFF" 
                                                                    SnapsToDevicePixels="True">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <!-- Sticky Desktop Notes Panel (Right-aligned, inset margin) -->
        <Border x:Name="NotesContainer"
                AutomationProperties.AutomationId="NotesContainer"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#D90C0C0E" 
                BorderBrush="#1AFFFFFF" 
                BorderThickness="1,0,1,1" 
                CornerRadius="0,0,8,8"
                Width="320"
                Margin="0,0,16,0"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" Color="#000000" />
            </Border.Effect>
            
            <Grid x:Name="NotesGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header preview row -->
                    <RowDefinition x:Name="EditorRow" Height="0"/> <!-- Text Editor (Height is 0 when collapsed) -->
                </Grid.RowDefinitions>
                
                <!-- Notes Bar Header (Click to expand/collapse) -->
                <Grid x:Name="NotesHeaderGrid" Grid.Row="0" Height="44" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="NotesHeader_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Status Bullet/Icon -->
                        <ColumnDefinition Width="*"/>    <!-- Text preview -->
                        <ColumnDefinition Width="Auto"/> <!-- Expander Indicator -->
                    </Grid.ColumnDefinitions>

                    <!-- Low-profile notes indicator bullet -->
                    <Ellipse Grid.Column="0" Width="6" Height="6" Margin="14,0,8,0" Fill="#80FFFFFF" VerticalAlignment="Center"/>

                    <!-- Preview of note's first line -->
                    <TextBlock x:Name="NotesPreviewBlock"
                               Grid.Column="1"
                               Text="{Binding CurrentNotePreview, FallbackValue='Click to add notes...'}"
                               Foreground="#99FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI Variable Text, Inter, Segoe UI, Arial"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0"/>

                    <!-- Expand/Collapse toggle icon -->
                    <TextBlock x:Name="ToggleIndicator"
                               Grid.Column="2"
                               Text="▾"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>
                </Grid>

                <!-- Expanded Text Editor Area -->
                <Grid Grid.Row="1" Margin="10,0,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="NotesTextBox"
                             Grid.Row="0"
                             Height="180"
                             Text="{Binding CurrentNoteText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#20000000"
                             BorderBrush="#20FFFFFF"
                             BorderThickness="1"
                             Foreground="#FFFFFFFF"
                             CaretBrush="#FFFFFFFF"
                             Padding="6"
                             FontSize="12"
                             FontFamily="Segoe UI Variable Text, Inter, Consolas, Arial"
                             LostFocus="NotesTextBox_LostFocus"/>

                    <Button Grid.Row="1"
                            Content="Done"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0"
                            Padding="16,4,16,4"
                            Click="DoneButton_Click"
                            Style="{StaticResource HeaderButtonStyle}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Sticky Notes Button (Right-aligned, inset margin) -->
        <Border x:Name="NotesButton"
                AutomationProperties.AutomationId="NotesButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#D90C0C0E" 
                BorderBrush="#1AFFFFFF" 
                BorderThickness="1,0,1,1" 
                CornerRadius="0,0,8,8"
                Height="46"
                Width="46"
                Margin="0,0,16,0"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" Color="#000000" />
            </Border.Effect>
            <Button Style="{StaticResource HeaderButtonStyle}"
                    AutomationProperties.AutomationId="NotesButtonActual"
                    Padding="0"
                    Margin="0"
                    Width="44"
                    Height="44"
                    Click="NotesButton_Click"
                    ToolTip="Active Desktop Notes">
                <TextBlock Text="📝" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Border>

        <!-- Popup for Notes -->
        <Popup x:Name="NotesPopup" 
               PlacementTarget="{Binding ElementName=NotesButton}" 
               Placement="Bottom" 
               AllowsTransparency="True" 
               StaysOpen="False" 
               PopupAnimation="Fade"
               HorizontalOffset="-274"
               VerticalOffset="4">
            <Border Background="#D90C0C0E" 
                    BorderBrush="#1AFFFFFF" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Width="320" 
                    Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBox x:Name="PopupNotesTextBox"
                             Grid.Row="0"
                             Height="180"
                             Text="{Binding CurrentNoteText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#20000000"
                             BorderBrush="#20FFFFFF"
                             BorderThickness="1"
                             Foreground="#FFFFFFFF"
                             CaretBrush="#FFFFFFFF"
                             Padding="6"
                             FontSize="12"
                             FontFamily="Segoe UI Variable Text, Inter, Consolas, Arial"
                             LostFocus="NotesTextBox_LostFocus"/>
                             
                    <Button Grid.Row="1"
                            Content="Done"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0"
                            Padding="16,4,16,4"
                            Click="PopupDoneButton_Click"
                            Style="{StaticResource HeaderButtonStyle}"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
